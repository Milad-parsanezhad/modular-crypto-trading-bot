# Exchange Configuration - تنظیم صرافی
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=4h

# API Credentials (Never commit this file!) - اعتبارات API
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Trading Parameters - پارامترهای معاملات
INITIAL_CAPITAL=100
POSITION_SIZE_PCT=0.50
FEE_BPS=10
SLIPPAGE_BPS=5

# Risk Management - مدیریت ریسک
MAX_DRAWDOWN_PCT=0.15
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
MAX_POSITIONS=1
MAX_DAILY_LOSS_PCT=0.20
MAX_TRADES_PER_DAY=5

# Updates - بروزرسانی‌ها
SIGNAL_UPDATE_HOURS=4
RISK_CHECK_MINUTES=5

# Logging - ثبت
LOG_DIR=logs
DEBUG_MODE=false
